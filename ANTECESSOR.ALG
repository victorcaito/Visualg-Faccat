Algoritmo "antecessor"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   : Mostra número anterior
// Autor(a)    : Victor
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
numero1:inteiro
anterior:inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Número antecessor")
escreva("Digite um número :")
leia(numero1)
anterior<-numero1-1
escreva("O número antecessor é : ", anterior)
Fimalgoritmo