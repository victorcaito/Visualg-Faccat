Algoritmo "idade"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   : Mostra número anterior
// Autor(a)    : Victor
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
mes:inteiro
dias:inteiro
anos:inteiro
calcularanos:inteiro
calculardias:inteiro
calcularmes:inteiro
resultado:inteiro
idade:inteiro
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Sua idade em dias")

         escreva("Digite sua idade em anos: ")
         leia(idade)
         resultado<-idade*30
         resultado<-idade*356
         escreva("Sua idade em dias: ", resultado)

//escreva("Digite sua idade em anos :")
//leia(anos)
//escreva("Digite o valor de sua idade em meses :")
//leia(mes)
//escreva("Digite a sua idade em dias :")
//leia(dias)
//calcularanos<-anos*365
//calculardias<-dias
//calcularmes<-mes*30
//resultado<-calculardias + calcularmes + calcularanos
//escreva("Sua idade em dias é: ", resultado)
Fimalgoritmo