Algoritmo "tabelacompletar34"
// Disciplina   : [ Lógica de Programação]
// Professor   : Jailson
// Descrição   : Verificar
// Autor(a)    : Victor Leonardo da Silva Varjão
// Data atual  : 22/09/2026
Var
       X, Y, z:inteiro
     resposta:caracter
Inicio

escreval("Um numero: ")
leia(X)
escreval("Outro número: ")
leia(Y)
z<-(x*y) + 5
se (z <= 0) então
resposta<- "A"
senão
se (z <= 100) então
resposta <- "B"
senão
resposta<- "C"
 fimse
 fimse
escreval("é ", resposta ," e ", z)
Fimalgoritmo