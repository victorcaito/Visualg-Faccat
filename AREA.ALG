Algoritmo "area"
// Disciplina   : [Lógica de Programação]
// Professor   : Jailson
// Descrição   : Mostra número anterior
// Autor(a)    : Victor
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
altura:inteiro
base:inteiro
resultado:inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Número antecessor")

escreva("Digite o valor da base :")
leia(base)
escreva("Digite o valor da altura :")
leia(altura)
resultado<-altura*base
escreva("A área é : ", resultado)
Fimalgoritmo