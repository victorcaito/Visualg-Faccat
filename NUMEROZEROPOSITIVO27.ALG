Algoritmo "numerozeropositivo27"
// Disciplina   : [ Lógica de Programação]
// Professor   : Jailson
// Descrição   : Verificar estoque
// Autor(a)    : Victor Leonardo da Silva Varjão
// Data atual  : 22/09/2026
Var
numero:real
Inicio
escreval("diga um número: ")
leia(numero)
se (numero < 0) entao
escreval("negativo")
senao se (numero = 0) entao
escreval("Numero zero.")
senao
escreval("positivo")
fimse
Fimalgoritmo