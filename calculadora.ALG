Algoritmo "subtração"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson
// Descrição   : Exibe uma mensagem na tela informando subtração da conta
// Autor(a)    : Victor
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
numero1:inteiro
numero2:inteiro
subtracao:inteiro
escreval:character

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreva("Programa soma")
escreva("Digite um número :")
leia(numero1)
escreva("Digite outro número :")
leia(numero2)
subtracao<-numero1-numero2
escreva("A subtracao é : ", subtracao)
Fimalgoritmo